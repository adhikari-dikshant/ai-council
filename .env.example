# ── OpenRouter ────────────────────────────────────────────────────────────────
# Required — get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional — model used by all council agents (default: openai/gpt-4o-mini)
# If set, overrides per-agent model choices. Remove to use model diversity.
# COUNCIL_MODEL=openai/gpt-4o-mini

# Optional — shown as HTTP-Referer to OpenRouter
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path (auto-created on first `npm run db:push`)
DATABASE_URL="file:./prisma/dev.db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=
