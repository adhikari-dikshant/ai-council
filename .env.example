# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then grab these from:
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional — overrides per-agent model choices (removes model diversity)
# COUNCIL_MODEL=openai/gpt-4o-mini

# Optional — shown as HTTP-Referer to OpenRouter
NEXT_PUBLIC_APP_URL=http://localhost:3000
