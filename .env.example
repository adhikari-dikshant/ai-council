# Required: your OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional: override the model used for all council agents (default: openai/gpt-4o-mini)
# Any model available on OpenRouter works, e.g.:
#   anthropic/claude-3.5-sonnet
#   google/gemini-flash-1.5
#   meta-llama/llama-3.1-70b-instruct
COUNCIL_MODEL=openai/gpt-4o-mini

# Optional: shown as HTTP-Referer to OpenRouter (helps with rate limits)
NEXT_PUBLIC_APP_URL=http://localhost:3000
